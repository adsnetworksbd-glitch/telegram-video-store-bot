# Firebase Admin SDK (JSON string of service account)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Telegram Bot Token (for initData verification)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin panel secret key
ADMIN_SECRET=your_very_strong_secret_key_here

# BscScan API key (free — for BEP20 verification)
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Server
PORT=8000
